{
  "name": "bluearchive-desktop-pet",
  "productName": "샬레 당번",
  "version": "1.2.0",
  "description": "샬레 당번",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "ba-click-fx": "1.3.9",
    "electron-updater": "6.8.11",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.bluearchive.desktoppet",
    "directories": {
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "dxsworks",
        "repo": "SD_archive"
      }
    ],
    "files": [
      "src/**/*",
      "assets/**/*",
      "models/Hoshino.glb",
      "package.json",
      "!node_modules/three/src/**/*",
      {
        "from": "node_modules/three/examples/jsm",
        "to": "node_modules/three/examples/jsm",
        "filter": [
          "loaders/GLTFLoader.js",
          "controls/OrbitControls.js",
          "utils/BufferGeometryUtils.js"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/pet.ico",
      "artifactName": "BlueArchivePet-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "include": "build/installer.nsh",
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "샬레 당번",
      "uninstallDisplayName": "샬레 당번",
      "installerIcon": "assets/pet.ico",
      "uninstallerIcon": "assets/pet.ico",
      "installerLanguages": [
        "ko_KR"
      ],
      "language": "1042",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": true
    }
  }
}
